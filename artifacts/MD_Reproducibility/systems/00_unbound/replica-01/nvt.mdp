define = -DPOSRES
integrator = md
dt = 0.002
nsteps = 50000
continuation = no
constraint_algorithm = lincs
constraints = h-bonds
cutoff-scheme = Verlet
nstlist = 20
rlist = 1.0
coulombtype = PME
rcoulomb = 1.0
vdwtype = cutoff
rvdw = 1.0
DispCorr = EnerPres
tcoupl = V-rescale
tc-grps = Protein Non-Protein
tau_t = 0.1 0.1
ref_t = 310 310
pcoupl = no
gen_vel = yes
gen_temp = 310
gen_seed = 18473
pbc = xyz
nstenergy = 500
nstlog = 500
nstxout-compressed = 5000
